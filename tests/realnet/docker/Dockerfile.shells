# The install part (tests/realnet/install.sh, docs/m4/plan.md §3 U1): hosts whose users log in
# with each shell the install bootstrap must survive. Two images from one file:
#
#   --target shells   Ubuntu: users u-bash, u-dash, u-zsh, u-fish, u-tcsh (each its login
#                     shell), and gated, whose key allows only `/opt/fil/fil server --stdio`
#   --target alpine   stock Alpine: busybox ash as the login shell of u-ash, busybox's own head,
#                     expr, ls and sha256sum (only openssh is added, to log in at all)
#
# No fil is on any user's PATH: the install puts one in their home. Nothing secret is baked in;
# keys and host keys are made at run time. Both bases are pinned by digest; update on purpose.
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852 AS shells
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server bash dash zsh fish tcsh procps \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd /etc/fil-realnet/keys /opt/fil
RUN for s in bash dash zsh fish tcsh; do \
      useradd -m -s "$(command -v "$s")" "u-$s" && usermod -p '*' "u-$s"; \
    done \
 && useradd -m -s /bin/bash gated && usermod -p '*' gated
COPY sshd_config.shells /etc/ssh/sshd_config
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY bin/fil-boot /opt/fil/fil
RUN chmod 755 /usr/local/bin/entrypoint.sh /opt/fil/fil
CMD ["/usr/local/bin/entrypoint.sh"]

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc AS alpine
RUN apk add --no-cache openssh-server \
 && mkdir -p /etc/fil-realnet/keys \
 && adduser -D -s /bin/sh u-ash \
 && sed -i 's/^u-ash:!:/u-ash:*:/' /etc/shadow
COPY sshd_config.shells /etc/ssh/sshd_config
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh
CMD ["/usr/local/bin/entrypoint.sh"]
