# The Homebrew formula of fil, for the tap anthonytw/homebrew-tap (`brew install anthonytw/tap/fil`).
# GENERATED from packaging/homebrew/fil.rb.in by `just brew-formula VERSION` (packaging/render.sh),
# with the checksums of the release's signed SHA256SUMS; do not edit it in the tap by hand.
# docs/m4/packaging.md says how a release reaches the tap.
class Fil < Formula
  desc "Remote shell for development over SSH that keeps your place"
  homepage "https://github.com/anthonytw/fil"
  version "@VERSION@"
  license "GPL-3.0-or-later"

  on_macos do
    url "@URL_BASE@/fil-@VERSION@-universal-apple-darwin.tar.gz"
    sha256 "@SHA256_UNIVERSAL_APPLE_DARWIN@"
  end

  on_linux do
    on_intel do
      url "@URL_BASE@/fil-@VERSION@-x86_64-linux-musl.tar.gz"
      sha256 "@SHA256_X86_64_LINUX_MUSL@"
    end
    on_arm do
      url "@URL_BASE@/fil-@VERSION@-aarch64-linux-musl.tar.gz"
      sha256 "@SHA256_AARCH64_LINUX_MUSL@"
    end
  end

  def install
    bin.install "bin/fil"
    # The remote bundle that `fil install` uploads; the client finds it at ../libexec/fil/remote
    # from its own canonical path, which in the Cellar is prefix/libexec/fil/remote.
    libexec.install "libexec/fil"
    man1.install Dir["share/man/man1/*.1"]
    man5.install Dir["share/man/man5/*.5"]
    bash_completion.install "share/bash-completion/completions/fil" if File.exist?("share/bash-completion/completions/fil")
    zsh_completion.install "share/zsh/site-functions/_fil" if File.exist?("share/zsh/site-functions/_fil")
    fish_completion.install "share/fish/vendor_completions.d/fil.fish" if File.exist?("share/fish/vendor_completions.d/fil.fish")
    doc.install Dir["share/doc/fil/*"]
  end

  def caveats
    <<~EOS
      fil also has to be on the remote hosts you use it with: `fil install HOST` uploads it,
      or copy a release's bin/fil there yourself (`fil install --help`).
    EOS
  end

  test do
    assert_match "fil #{version} (wire ", shell_output("#{bin}/fil --version")
    # The bundle is where the client looks for it, and it checks.
    cd libexec/"fil/remote" do
      system "shasum", "-a", "256", "-c", "SHA256SUMS"
    end
  end
end
